MONGODB_URI=mongodb://127.0.0.1:27017/malmi_lifestyle
LOCAL_MONGODB_URI=mongodb://127.0.0.1:27017/malmi_lifestyle
ALLOW_LOCAL_SEED=false
LIVE_MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/malmi-lifestyle?retryWrites=true&w=majority
ADMIN_EMAIL=admin@malmilifestyle.com
ADMIN_PASSWORD=replace-with-a-strong-password
SESSION_SECRET=replace-with-a-long-random-secret
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Razorpay (server-only). Test-mode values are fine until go-live.
# Key id/secret power online checkout (order creation + handoff verification).
# The webhook secret validates incoming Razorpay webhook signatures.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_signing_secret
# Optional override of the Razorpay REST base URL. Leave unset in production;
# only set it to point the client at a stub server in tests.
# RAZORPAY_API_BASE_URL=https://api.razorpay.com
